{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rémy",
  "mainBinaryName": "Remy",
  "version": "0.1.0",
  "identifier": "com.pingureep.remy.bureau",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Rémy",
    "copyright": "Licence MIT",
    "category": "Productivity",
    "shortDescription": "Rémy, ton directeur de cabinet, sur Windows",
    "longDescription": "La fenêtre de Rémy servie par ta tour, une icône près de l'horloge, Noter au clavier (Ctrl+Alt+Espace) et les rappels en notifications Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
