# Posé par `npm test` (Lot 0, J0.5) : en test, le code refuse toute requête
# vers un vrai Motion ou un vrai Google (lib/bac-a-sable.js).
REMY_ENV=test
MOTION_QUOTA_MIN=100000
MOTION_DELAI_MS=5000
# Le travail de fond cède la place (lib/priorite.js) : en test, pas de répit
# après une demande, sauf quand un test le pose lui-même.
REMY_FOND_REPIT_MS=0
